# The ACTIV backend. This is the SAME server the mobile app uses — one backend,
# two clients. It listens on 5000 (backend/.env -> PORT).
# The /api/v1 suffix is appended automatically if omitted.
VITE_API_URL=http://localhost:5000/api/v1
API_URL=http://localhost:5000/api/v1
SITE_URL=http://localhost:5173

# The public site: every event QR code opens this domain (EventQr.tsx).
VITE_PUBLIC_SITE_URL=https://activ.welocalhost.com
