# The public site: every event QR code opens this domain (EventQr.tsx).
VITE_PUBLIC_SITE_URL=https://activ.org.in

# Public Web stream for the existing activ-production Firebase project.
# Ship the production default even when the host omits build-time variables.
VITE_GA_MEASUREMENT_ID=G-SVTY6PH9ZX
